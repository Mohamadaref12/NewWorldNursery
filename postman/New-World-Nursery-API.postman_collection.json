{
  "info": {
    "_postman_id": "nwn-api-collection",
    "name": "New World Nursery API",
    "description": "Public API for New World Nursery (Laravel).\n\n## Localization (EN / AR)\nPass locale on every request:\n- Query: `?locale=en` or `?locale=ar`\n- Header: `X-Locale: en|ar`\n- Or `Accept-Language: ar`\n\nResponse header: `Content-Language`\n\n`GET /api/home` and `GET /api/settings` also return body field `locale`.\n\nDocs:\n- docs/FRONTEND_TRANSLATIONS.md (i18n changes for frontend)\n- docs/FRONTEND_API.md\n- docs/BLOG_API.md\n- docs/GALLERY_API.md\n- docs/INSTAGRAM_INTEGRATION.md",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://new-world-nursery.test" },
    { "key": "locale", "value": "en" },
    { "key": "locationId", "value": "1" },
    { "key": "programId", "value": "1" },
    { "key": "categorySlug", "value": "moments-of-joy" },
    { "key": "blogSlug", "value": "a-happy-start-to-nursery-life" },
    { "key": "blogLimit", "value": "5" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "i18n",
      "description": "Examples with English vs Arabic locale. Change collection variable `locale` or use these dedicated requests.",
      "item": [
        {
          "name": "Home (EN)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Locale", "value": "en" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/home?locale=en",
              "host": ["{{baseUrl}}"],
              "path": ["api", "home"],
              "query": [{ "key": "locale", "value": "en" }]
            },
            "description": "Homepage payload in English. Check `locale` in body and `Content-Language` header."
          },
          "response": []
        },
        {
          "name": "Home (AR)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Locale", "value": "ar" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/home?locale=ar",
              "host": ["{{baseUrl}}"],
              "path": ["api", "home"],
              "query": [{ "key": "locale", "value": "ar" }]
            },
            "description": "Homepage payload in Arabic. Translated fields (titles, descriptions, settings copy) switch to AR when available; otherwise fall back to EN."
          },
          "response": []
        },
        {
          "name": "Settings (AR)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Locale", "value": "ar" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/settings?locale=ar",
              "host": ["{{baseUrl}}"],
              "path": ["api", "settings"],
              "query": [{ "key": "locale", "value": "ar" }]
            },
            "description": "Site settings translated strings (hero, about, section headings, contact address, footer). Shared fields (phones, emails, URLs, images) stay the same."
          },
          "response": []
        },
        {
          "name": "Features (AR)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Locale", "value": "ar" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/features?locale=ar",
              "host": ["{{baseUrl}}"],
              "path": ["api", "features"],
              "query": [{ "key": "locale", "value": "ar" }]
            },
            "description": "`title` and `description` are translated."
          },
          "response": []
        },
        {
          "name": "Blogs (AR)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Locale", "value": "ar" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/blogs?locale=ar",
              "host": ["{{baseUrl}}"],
              "path": ["api", "blogs"],
              "query": [{ "key": "locale", "value": "ar" }]
            },
            "description": "`title`, `slug`, `excerpt`, `content` are translated. Use the locale-specific `slug` for detail routes when navigating in that language."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Home",
      "item": [
        {
          "name": "Get Home Content",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Locale", "value": "{{locale}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/home?locale={{locale}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "home"],
              "query": [
                { "key": "locale", "value": "{{locale}}", "description": "en | ar" }
              ]
            },
            "description": "Homepage payload: settings, features, locations, programs, gallery_categories, gallery_items/moments, instagram/gallery.\n\nAlso returns top-level `locale`."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Settings",
      "item": [
        {
          "name": "Get Site Settings",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Locale", "value": "{{locale}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/settings?locale={{locale}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "settings"],
              "query": [
                { "key": "locale", "value": "{{locale}}", "description": "en | ar" }
              ]
            },
            "description": "Site settings for current locale. Returns `{ locale, data }`."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Features",
      "item": [
        {
          "name": "List Features",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Locale", "value": "{{locale}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/features?locale={{locale}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "features"],
              "query": [
                { "key": "locale", "value": "{{locale}}", "description": "en | ar" }
              ]
            },
            "description": "Active features. Translated: title, description."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Locations",
      "item": [
        {
          "name": "List Locations",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Locale", "value": "{{locale}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/locations?locale={{locale}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "locations"],
              "query": [
                { "key": "locale", "value": "{{locale}}", "description": "en | ar" }
              ]
            },
            "description": "Active locations. Translated: name, city, country, address, working_hours."
          },
          "response": []
        },
        {
          "name": "Get Location by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Locale", "value": "{{locale}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/locations/{{locationId}}?locale={{locale}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "locations", "{{locationId}}"],
              "query": [
                { "key": "locale", "value": "{{locale}}", "description": "en | ar" }
              ]
            },
            "description": "Single active location by ID."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Programs",
      "item": [
        {
          "name": "List Programs",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Locale", "value": "{{locale}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/programs?locale={{locale}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "programs"],
              "query": [
                { "key": "locale", "value": "{{locale}}", "description": "en | ar" }
              ]
            },
            "description": "Active programs. Translated: title, age_range, description."
          },
          "response": []
        },
        {
          "name": "Get Program by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Locale", "value": "{{locale}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/programs/{{programId}}?locale={{locale}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "programs", "{{programId}}"],
              "query": [
                { "key": "locale", "value": "{{locale}}", "description": "en | ar" }
              ]
            },
            "description": "Single active program by ID."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Gallery",
      "item": [
        {
          "name": "List Gallery Images",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Locale", "value": "{{locale}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/gallery?locale={{locale}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gallery"],
              "query": [
                { "key": "locale", "value": "{{locale}}", "description": "en | ar" }
              ]
            },
            "description": "Gallery images. Translated: alt, category.name, category.slug."
          },
          "response": []
        },
        {
          "name": "List Gallery Images by Category",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Locale", "value": "{{locale}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/gallery?category={{categorySlug}}&locale={{locale}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gallery"],
              "query": [
                { "key": "category", "value": "{{categorySlug}}", "description": "Category slug (any locale) or numeric id" },
                { "key": "locale", "value": "{{locale}}", "description": "en | ar" }
              ]
            },
            "description": "Filter by category slug (matches any locale slug) or id."
          },
          "response": []
        },
        {
          "name": "List Gallery Categories",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Locale", "value": "{{locale}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/gallery/categories?locale={{locale}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gallery", "categories"],
              "query": [
                { "key": "locale", "value": "{{locale}}", "description": "en | ar" }
              ]
            },
            "description": "Categories with nested items. Translated: name, slug, items[].alt."
          },
          "response": []
        },
        {
          "name": "Get Category with Images",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Locale", "value": "{{locale}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/gallery/categories/{{categorySlug}}?locale={{locale}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gallery", "categories", "{{categorySlug}}"],
              "query": [
                { "key": "locale", "value": "{{locale}}", "description": "en | ar" }
              ]
            },
            "description": "One category by slug (EN or AR slug works)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Instagram",
      "item": [
        {
          "name": "List Instagram Posts",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Locale", "value": "{{locale}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/instagram?locale={{locale}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "instagram"],
              "query": [
                { "key": "locale", "value": "{{locale}}", "description": "en | ar" }
              ]
            },
            "description": "Instagram posts. Translated: alt."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Blogs",
      "item": [
        {
          "name": "List Blogs",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Locale", "value": "{{locale}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/blogs?locale={{locale}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "blogs"],
              "query": [
                { "key": "locale", "value": "{{locale}}", "description": "en | ar" }
              ]
            },
            "description": "Published blogs. Translated: title, slug, excerpt, content."
          },
          "response": []
        },
        {
          "name": "Latest Blogs",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Locale", "value": "{{locale}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/blogs/latest?limit={{blogLimit}}&locale={{locale}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "blogs", "latest"],
              "query": [
                { "key": "limit", "value": "{{blogLimit}}", "description": "Default 5, min 1, max 20" },
                { "key": "locale", "value": "{{locale}}", "description": "en | ar" }
              ]
            },
            "description": "Latest published blogs for current locale."
          },
          "response": []
        },
        {
          "name": "Get Blog by Slug",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Locale", "value": "{{locale}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/blogs/{{blogSlug}}?locale={{locale}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "blogs", "{{blogSlug}}"],
              "query": [
                { "key": "locale", "value": "{{locale}}", "description": "en | ar" }
              ]
            },
            "description": "Single blog. Slug can be EN or AR translation slug."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Contact",
      "item": [
        {
          "name": "Send Contact Message",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Locale", "value": "{{locale}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Smith\",\n  \"email\": \"jane@example.com\",\n  \"phone\": \"+971501234567\",\n  \"program\": \"Toddlers\",\n  \"child_age\": \"3 years\",\n  \"message\": \"I would like to book a visit for my child.\"\n}"
            },
            "url": "{{baseUrl}}/api/contact",
            "description": "Contact form. Not translated (user-submitted data).\n\nFor `program`, prefer the program `title` from `/api/programs?locale=...` in the active language."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Get Authenticated User",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{token}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/user",
            "description": "Authenticated user (Sanctum). No translation impact."
          },
          "response": []
        }
      ]
    }
  ]
}

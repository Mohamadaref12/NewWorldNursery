{
  "info": {
    "_postman_id": "nwn-api-collection",
    "name": "New World Nursery API",
    "description": "Public API endpoints for New World Nursery (Laravel).\n\nDocs:\n- docs/FRONTEND_API.md\n- docs/BLOG_API.md\n- docs/GALLERY_API.md\n- docs/INSTAGRAM_INTEGRATION.md",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Home",
      "item": [
        {
          "name": "Get Home Content",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/home",
            "description": "Homepage payload: settings, features, locations, programs, gallery_categories, gallery_items/moments, instagram/gallery."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Settings",
      "item": [
        {
          "name": "Get Site Settings",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/settings",
            "description": "Returns site settings (hero, about, section headings, Instagram, Moments, contact, footer)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Features",
      "item": [
        {
          "name": "List Features",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/features",
            "description": "Returns active features ordered by sort_order."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Locations",
      "item": [
        {
          "name": "List Locations",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/locations",
            "description": "Returns active nursery locations."
          },
          "response": []
        },
        {
          "name": "Get Location by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/locations/{{locationId}}",
            "description": "Returns a single active location by ID."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Programs",
      "item": [
        {
          "name": "List Programs",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/programs",
            "description": "Returns active programs ordered by sort_order."
          },
          "response": []
        },
        {
          "name": "Get Program by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/programs/{{programId}}",
            "description": "Returns a single active program by ID."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Gallery",
      "item": [
        {
          "name": "List Gallery Images",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/gallery",
            "description": "Returns all active gallery images (with category). From gallery_items table."
          },
          "response": []
        },
        {
          "name": "List Gallery Images by Category",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/gallery?category={{categorySlug}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gallery"],
              "query": [
                {
                  "key": "category",
                  "value": "{{categorySlug}}",
                  "description": "Category slug or numeric id"
                }
              ]
            },
            "description": "Returns gallery images filtered by category slug or id."
          },
          "response": []
        },
        {
          "name": "List Gallery Categories",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/gallery/categories",
            "description": "Returns all active categories, each with nested active items."
          },
          "response": []
        },
        {
          "name": "Get Category with Images",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/gallery/categories/{{categorySlug}}",
            "description": "Returns one category by slug with its active images in items[]."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Instagram",
      "item": [
        {
          "name": "List Instagram Posts",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/instagram",
            "description": "Returns synced Instagram posts from instagram_posts (separate from gallery). Empty until Connect + Sync in admin."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Blogs",
      "item": [
        {
          "name": "List Blogs",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/blogs",
            "description": "Returns all published active blogs (newest first)."
          },
          "response": []
        },
        {
          "name": "Latest Blogs",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/blogs/latest?limit={{blogLimit}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "blogs", "latest"],
              "query": [
                {
                  "key": "limit",
                  "value": "{{blogLimit}}",
                  "description": "Default 5, min 1, max 20"
                }
              ]
            },
            "description": "Returns the latest published blogs."
          },
          "response": []
        },
        {
          "name": "Get Blog by Slug",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/blogs/{{blogSlug}}",
            "description": "Returns a single published blog by slug."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Contact",
      "item": [
        {
          "name": "Send Contact Message",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Smith\",\n  \"email\": \"jane@example.com\",\n  \"phone\": \"+971501234567\",\n  \"program\": \"Toddlers\",\n  \"child_age\": \"3 years\",\n  \"message\": \"I would like to book a visit for my child.\"\n}"
            },
            "url": "{{baseUrl}}/api/contact",
            "description": "Submits a contact / plan-a-visit message.\n\nRequired: name, email, message\nOptional: phone, program, child_age"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Get Authenticated User",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{token}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/user",
            "description": "Returns the authenticated user (Sanctum Bearer token required)."
          },
          "response": []
        }
      ]
    }
  ]
}

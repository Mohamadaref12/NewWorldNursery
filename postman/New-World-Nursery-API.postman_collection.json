{
  "info": {
    "_postman_id": "nwn-api-collection",
    "name": "New World Nursery API",
    "description": "Public API endpoints for New World Nursery (Laravel).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Home",
      "item": [
        {
          "name": "Get Home Content",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/home",
            "description": "Returns homepage payload: settings, features, locations, programs, and gallery."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Settings",
      "item": [
        {
          "name": "Get Site Settings",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/settings",
            "description": "Returns site settings (hero, about, section headings, contact, footer)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Features",
      "item": [
        {
          "name": "List Features",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/features",
            "description": "Returns active features ordered by sort_order."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Locations",
      "item": [
        {
          "name": "List Locations",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/locations",
            "description": "Returns active nursery locations."
          },
          "response": []
        },
        {
          "name": "Get Location by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/locations/{{locationId}}",
            "description": "Returns a single active location by ID."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Programs",
      "item": [
        {
          "name": "List Programs",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/programs",
            "description": "Returns active programs ordered by sort_order."
          },
          "response": []
        },
        {
          "name": "Get Program by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/programs/{{programId}}",
            "description": "Returns a single active program by ID."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Gallery",
      "item": [
        {
          "name": "List Gallery Items",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/gallery",
            "description": "Returns active gallery images with full image URLs."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Contact",
      "item": [
        {
          "name": "Send Contact Message",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Smith\",\n  \"email\": \"jane@example.com\",\n  \"phone\": \"+971501234567\",\n  \"program\": \"Toddlers\",\n  \"child_age\": \"3 years\",\n  \"message\": \"I would like to book a visit for my child.\"\n}"
            },
            "url": "{{baseUrl}}/api/contact",
            "description": "Submits a contact / plan-a-visit message.\n\nRequired: name, email, message\nOptional: phone, program, child_age"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Get Authenticated User",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{token}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/user",
            "description": "Returns the authenticated user (Sanctum Bearer token required)."
          },
          "response": []
        }
      ]
    }
  ]
}
